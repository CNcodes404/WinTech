# Frontend-safe values only (these are bundled into the browser).
# Copy to .env.local and fill in from Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# NEVER put SUPABASE_SERVICE_ROLE_KEY (or any secret key) in a VITE_ variable.
# Server-side secrets live only in Supabase Edge Function secrets.
